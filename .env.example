## ====================================================================
## 🤖 DISCORD BOT CONFIGURATION
## Variables utilizadas por el servicio discord_bot
## ====================================================================
DISCORD_TOKEN=your_discord_token
API_BASE_URL=http://api_rcon:8000
PUBLIC_API_URL=http://localhost:8000

## ====================================================================
## ⚙️ SHARED SECURITY & AUTH
## Claves compartidas entre el Bot y la API para autenticación y tokens
## ====================================================================
API_KEY=secret_prod_key

## ====================================================================
## 🌐 API & DATABASE CONFIGURATION (api_rcon)
## Variables utilizadas por el backend FastAPI, base de datos y migraciones
## ====================================================================
DATABASE_URL=postgresql+asyncpg://user:password@127.0.0.1:5432/database
STEAM_WEB_API_KEY=steam_web_api_key

## ====================================================================
## 🎮 RCON GAME SERVER (api_rcon)
## Conexión al servidor de juego para sincronización de slots y comandos
## ====================================================================
RCON_URL=http://127.0.0.1:9001
RCON_PASSWORD=rcon_pass

## ====================================================================
## 💳 TEBEX STORE INTEGRATION (api_rcon)
## Integración de pagos automáticos y validación de webhooks
## ====================================================================
TEBEX_WEBHOOK_SECRET=your_tebex_webhook_secret
TEBEX_API_KEY=your_tebex_api_key