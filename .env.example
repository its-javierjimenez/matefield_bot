## ====================================================================
## 🤝 1. AMBOS (VARIABLES COMPARTIDAS ENTRE BOT Y API)
## ====================================================================

# Token del Bot de Discord generado en Discord Developer Portal (sección Bot).
# - discord_bot: Se conecta al Gateway y registra/responde comandos slash.
# - api_rcon:    Asigna inmediatamente el rol verificado en Discord al completar la vinculación de Steam.
DISCORD_TOKEN=your_discord_bot_token

# URL pública de la API accesible desde Internet y navegadores por los usuarios.
# - discord_bot: Construye los enlaces de autorización de Steam OpenID enviados en Discord.
# - api_rcon:    Resuelve los callbacks y redirecciones de Steam OpenID.
# Ejemplos:
#   Local:      http://localhost:8000
#   Producción: https://api.tudominio.com (o http://<IP_PUBLICA>:8000)
PUBLIC_API_URL=http://localhost:8000

# Clave secreta compartida para autenticación máquina a máquina (M2M).
# - discord_bot: La envía en la cabecera HTTP 'X-API-Key' en todas sus peticiones hacia la API.
# - api_rcon:    La valida para autorizar el acceso a sus endpoints protegidos.
API_KEY=your_secret_api_key_here


## ====================================================================
## 🤖 2. BOT (EXCLUSIVAS DE DISCORD_BOT)
## ====================================================================

# URL interna del backend FastAPI (api_rcon) a la que se conecta el cliente HTTP del bot.
# Ejemplos:
#   Docker Compose: http://api_rcon:8000
#   Local (manual): http://127.0.0.1:8000
API_BASE_URL=http://api_rcon:8000

# Emoji utilizado en los botones interactivos de vinculación de Discord (ej. /player link_channel).
# Puede ser un emoji unicode estándar (ej. 🎮) o un emoji personalizado (<:nombre:ID>).
# Opcional (por defecto: 🎮)
STEAM_LINK_EMOJI=🎮


## ====================================================================
## 🌐 3. API (EXCLUSIVAS DE API_RCON, DB & SERVICIOS)
## ====================================================================

# Entorno de ejecución: 'development', 'production', 'local' o 'test'.
# En 'production' se activan optimizaciones como caché de plantillas y validaciones estrictas.
APP_ENV=development

# Cadena de conexión asíncrona a la base de datos PostgreSQL (SQLAlchemy + asyncpg).
# Utilizada por 'api_rcon' y por las migraciones de base de datos con Alembic.
# Formato: postgresql+asyncpg://<usuario>:<contraseña>@<host>:<puerto>/<nombre_db>
# Ejemplos:
#   Local Docker: postgresql+asyncpg://matefield_user:matefield_password@postgres:5432/matefield_db
#   Local manual: postgresql+asyncpg://postgres:password@127.0.0.1:5432/matefield_db
#   Producción:   postgresql+asyncpg://user:pass@dbhost.com:5432/dbname
DATABASE_URL=postgresql+asyncpg://user:password@127.0.0.1:5432/database

# Clave de la API web de Valve Steam (obtenida en https://steamcommunity.com/dev/apikey).
# Permite consultar la API oficial de Steam para obtener nombre de usuario, avatar y perfil.
STEAM_WEB_API_KEY=your_steam_web_api_key

# URL base del servicio RCON del servidor de juego (Squad) o del mock RCON en pruebas.
# Ejemplos:
#   Local (mock): http://mock_rcon:7776 (o http://127.0.0.1:7776)
#   Servidor Real: http://169.155.127.77:9001
RCON_URL=http://127.0.0.1:9001

# Contraseña de acceso al servicio RCON para ejecutar comandos administrativos,
# sincronizar slots reservados de miembros VIP y aplicar sanciones en el juego.
RCON_PASSWORD=your_rcon_password

# Secreto para verificar la firma criptográfica HMAC-SHA256 (cabecera X-Signature) de los webhooks de Tebex.
# Permite procesar de forma segura pagos, renovaciones de membresías y reembolsos.
TEBEX_WEBHOOK_SECRET=your_tebex_webhook_secret

# Clave de API de Tebex para consultas de tienda y paquetes.
TEBEX_API_KEY=your_tebex_api_key

# Enlace directo (deep link) al canal de Discord de bienvenida o general.
# Utilizado en el botón "Volver a Discord" de la página web de confirmación de vinculación Steam.
# Opcional (si no se define, utiliza el canal oficial de la comunidad por defecto).
DISCORD_GENERAL_CHANNEL_URL=https://discord.com/channels/YOUR_GUILD_ID/YOUR_CHANNEL_ID
