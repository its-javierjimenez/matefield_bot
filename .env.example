## ====================================================================
## 🤝 1. AMBOS (VARIABLES COMPARTIDAS ENTRE BOT Y API)
## ====================================================================

# Token del Bot de Discord generado en Discord Developer Portal
DISCORD_TOKEN=your_discord_bot_token

# URL pública de la API accesible desde Internet
# Ej: http://localhost:8000 o https://api.tudominio.com
PUBLIC_API_URL=http://localhost:8000

# Clave secreta compartida para autenticación entre servicios (M2M)
API_KEY=your_secret_api_key_here


## ====================================================================
## 🤖 2. BOT (EXCLUSIVAS DE DISCORD_BOT)
## ====================================================================

# URL interna del backend FastAPI a la que se conecta el cliente HTTP del bot.
# Ej: http://api_rcon:8000 (Docker) o http://127.0.0.1:8000 (Local)
API_BASE_URL=http://api_rcon:8000

# Emoji utilizado en los botones interactivos de vinculación de Discord.
# Formatos aceptados:
#   Unicode:     STEAM_LINK_EMOJI=🎮
#   ID:          STEAM_LINK_EMOJI=123456789012345678
#   Corto:       STEAM_LINK_EMOJI=:mf_steam:123456789012345678
#   Completo:    STEAM_LINK_EMOJI="<:mf_steam:123456789012345678>"
#   Animado:     STEAM_LINK_EMOJI="<a:mf_steam:123456789012345678>"
# IMPORTANTE: Si usas el formato con < >, encierra el valor entre comillas para evitar errores de parseo del .env.
STEAM_LINK_EMOJI=🎮


## ====================================================================
## 🌐 3. API (EXCLUSIVAS DE API_RCON, DB & SERVICIOS)
## ====================================================================

# Entorno de ejecución: 'development', 'production', 'local' o 'test'.
APP_ENV=development

# Cadena de conexión asíncrona a la base de datos PostgreSQL
# Formato: postgresql+asyncpg://<usuario>:<contraseña>@<host>:<puerto>/<nombre_db>
DATABASE_URL=postgresql+asyncpg://user:password@127.0.0.1:5432/database

# Clave de la API web de Valve Steam
STEAM_WEB_API_KEY=your_steam_web_api_key

# Configuración RCON global por defecto
RCON_URL=http://127.0.0.1:9001
RCON_PASSWORD=your_rcon_password

# Enlace directo al canal de Discord (Deep link para redirección web)
DISCORD_GENERAL_CHANNEL_URL=https://discord.com/channels/YOUR_GUILD_ID/YOUR_CHANNEL_ID

## ====================================================================
## 💳 4. TEBEX STORE INTEGRATION (api_rcon)
## Integración de pagos automáticos y validación de webhooks
## ====================================================================
TEBEX_WEBHOOK_SECRET=your_tebex_webhook_secret
TEBEX_API_KEY=your_tebex_api_key
